# ==============================================================================
# MHIDE STORY INTELLIGENCE — ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Copy this file to .env and configure as needed.
# DO NOT COMMIT .env TO VERSION CONTROL.

# Application Environment
APP_ENV=local                       # local | staging | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
TIMEZONE=Africa/Lagos               # Primary channel scheduling timezone
MIN_DISK_FREE_GB=10.0               # Minimum free disk space required before running jobs

# AI / LLM Provider (Zero-Cost Local Default or Google Gemini Free Tier)
MODEL_PROVIDER=gemini               # gemini | ollama | mock
GEMINI_API_KEY=                     # Google AI Studio API Key (Free tier: fast 2.0 Flash / 1.5 Flash)
GEMINI_MODEL=gemini-2.0-flash       # gemini-2.0-flash | gemini-1.5-flash
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b            # Local fast model for Intel Mac
OLLAMA_REASONING_MODEL=qwen2.5-coder:7b # Optional larger model for deep story critique
PAID_APIS_ENABLED=false             # Strict safety guard: prevents accidental paid charges

# Cinematic Voiceover (TTS) Engine (ElevenLabs Cinema-Grade or Tuned Edge-TTS)
TTS_PROVIDER=elevenlabs                 # elevenlabs | edge-tts | gemini
TTS_VOICE=en-US-GuyNeural               # en-US-GuyNeural (deep documentary) | en-GB-RyanNeural | en-US-ChristopherNeural
TTS_RATE=-6%                            # Suspenseful documentary pacing (-6% to -10%)
TTS_PITCH=-12Hz                         # Deep chest resonant timbre (-10Hz to -16Hz)
TTS_VOLUME=+0%

# ElevenLabs Cinema Voiceover (Gold Standard for Dark Mystery & True Crime)
# Get a free key at https://elevenlabs.io (Free tier includes 10,000 chars/month = ~15-20 Shorts)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB # 'Adam' (Deep Narrator) or 'nPczCjzI2devNBz1zQrb' ('Brian')
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Optional Open-Source Voice APIs from GitHub
FISH_AUDIO_API_KEY=                     # fish.audio (Fish-Speech engine on GitHub)
OPENAI_API_KEY=                         # OpenAI TTS (voice: onyx)

# YouTube Data API v3 & OAuth Configuration
# For Phase 2 (Public Research): Get a free API Key from Google Cloud Console.
YOUTUBE_API_KEY=
# For Phase 7 (Channel Upload & Analytics): OAuth 2.0 Client credentials JSON file.
YOUTUBE_CLIENT_SECRETS_FILE=credentials/client_secrets.json
YOUTUBE_TOKEN_FILE=data/youtube_token.json
# Publishing Safety Guard: 'disabled' (renders only), 'private_test' (private upload test), 'autonomous_public' (auto upload public Shorts)
YOUTUBE_PUBLISH_MODE=disabled
YOUTUBE_DEFAULT_PRIVACY=private     # private | unlisted | public

# Multi-Platform Publishing Modes (Stage 10)
INSTAGRAM_PUBLISH_MODE=disabled     # disabled | dry_run | publish
INSTAGRAM_ACCESS_TOKEN=             # Meta Graph API User Token with instagram_content_publish
INSTAGRAM_USER_ID=                  # Connected Instagram Professional User ID

TIKTOK_PUBLISH_MODE=disabled        # disabled | dry_run | publish
TIKTOK_CLIENT_KEY=                  # TikTok Developer App Client Key
TIKTOK_CLIENT_SECRET=               # TikTok Developer App Client Secret
TIKTOK_ACCESS_TOKEN=                # TikTok OAuth Access Token with video.publish scope

# Autonomous Engine & Launch Controls
AUTO_PUBLISH_ENABLED=false          # Master autonomous publishing switch (requires verified account)
AUTO_PUBLISH_DAILY_LIMIT=2          # Maximum automated uploads across all platforms per day
AUTO_PUBLISH_MIN_INTERVAL_HOURS=4.0 # Minimum hours required between automated uploads
AUTO_PUBLISH_MAX_DAILY_SPEND=0.0    # Hard ceiling on automated external API spend (₦0.00 / $0.00)
AUTO_PUBLISH_ALLOWED_HOURS=09-22    # Allowed daily posting window (Local time hours)
AUTO_PUBLISH_TIMEZONE=Africa/Lagos  # Primary audience/creator timezone
AUTO_PUBLISH_FAILURE_LIMIT=3        # Consecutive failed publishes before automatic safety pause

# Autonomous Operator & Scheduler Settings
AUTONOMOUS_RESEARCH_INTERVAL_HOURS=24 # Run autonomous competitor research every N hours
AUTONOMOUS_PRODUCTION_INTERVAL_HOURS=12 # Autonomous video generation cycle interval
AUTONOMOUS_PAUSED=false               # Global pause switch for autonomous operation
MAX_DAILY_UPLOADS=2                   # Hard limit on daily automated uploads

# Telegram Control Room Bot (Monitoring & Remote Control Room)
# Get a Bot token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram User IDs authorized to control the bot.
TELEGRAM_ALLOWED_USER_IDS=

# Creator Brand & Content Strategy
CREATOR_BRAND=MhideDev                  # Autonomous creator brand identity
NICHE_DEFAULT=Programming & Developer Culture # Primary content niche
DAILY_SHORTS_TARGET=1               # Target videos produced per day
MAX_QUEUE_SIZE=5                    # Max queued jobs before pausing generation
RENDER_CONCURRENCY=1                # Concurrent FFmpeg renders (keep at 1 on Intel Mac)
TARGET_VIDEO_DURATION_MIN=25        # Minimum target seconds for a Short
TARGET_VIDEO_DURATION_MAX=55        # Maximum target seconds for a Short

# Dashboard Configuration
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8501
